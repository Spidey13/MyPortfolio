{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "redirects": [
    { "source": "/projects", "destination": "/", "permanent": true },
    { "source": "/experience/:id", "destination": "/#experience", "permanent": true }
  ]
}
